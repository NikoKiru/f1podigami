{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_gate.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
